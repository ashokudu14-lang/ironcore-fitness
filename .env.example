# IronCore OS browser client configuration.
# Use only the Supabase project URL and publishable key here.
# Never put a service role key or secret key in a VITE_ variable.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Existing portfolio enquiry variables. These can be removed once the old
# portfolio enquiry endpoint is retired.
BUSINESS_WHATSAPP_NUMBER=
LEAD_NOTIFICATION_EMAIL=
RESEND_API_KEY=
